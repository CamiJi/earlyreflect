---
import '../styles/global.css';
import { site } from '../data/site';
import { pageUrl, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Chemin (sans base ni préfixe de langue) de l'équivalent dans l'autre langue, ex. "/work/" */
  altPath?: string;
  /** Libellé du lien d'évitement (§8 accessibilité) */
  skipLabel: string;
  /** Désactiver l'alternance hreflang (pages uniques) */
  noAlternate?: boolean;
  /** Image Open Graph (défaut : og-default.webp) */
  ogImage?: string;
  /** Données structurées schema.org (JSON-LD, spec §8) */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Type Open Graph (article pour les fiches projet) */
  ogType?: 'website' | 'article';
}

const { title, description, lang, altPath, skipLabel, noAlternate = false, ogImage, schema, ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const ogImageUrl = new URL(ogImage ?? `${base}og-default.webp`, Astro.site ?? site.url).href;
const faviconUrl = `${base}favicon.svg`;
const schemaList = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const otherLang: Lang = lang === 'en' ? 'fr' : 'en';
const alternates = noAlternate || !altPath
  ? []
  : [
      { lang, href: canonical },
      { lang: otherLang, href: new URL(pageUrl(otherLang, altPath), Astro.site ?? site.url).href },
      // x-default = version EN (langue par défaut à la racine, spec §2.4)
      { lang: 'x-default', href: new URL(pageUrl('en', altPath), Astro.site ?? site.url).href },
    ];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f4f4f0" />
    <meta name="generator" content={Astro.generator} />

    {alternates.map((alt) => <link rel="alternate" hreflang={alt.lang} href={alt.href} />)}

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph — og-default.webp par défaut ; les fiches passent leur key art -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />

    {schemaList.map((node) => <script is:inline type="application/ld+json" set:html={JSON.stringify(node)} />)}
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-surface focus:px-4 focus:py-2"
    >
      {skipLabel}
    </a>
    <slot />
  </body>
</html>
