---
/**
 * Façade Vimeo — spec §7 : paramètre dnt=1 et façade.
 * Miniature récupérée via l'oEmbed Vimeo au build, avec repli visuel.
 */
interface Props {
  id: string;
  title: string;
  class?: string;
}

const { id, title, class: className = '' } = Astro.props;
const embedUrl = `https://player.vimeo.com/video/${id}?dnt=1&autoplay=1`;
const watchUrl = `https://vimeo.com/${id}`;

let thumbUrl: string | null = null;
try {
  const res = await fetch(`https://vimeo.com/api/oembed.json?url=${encodeURIComponent(watchUrl)}&width=1280`);
  if (res.ok) {
    const json = await res.json();
    thumbUrl = json.thumbnail_url ?? null;
  }
} catch {
  thumbUrl = null;
}
---

<div class:list={['lite-embed media-16x9 relative bg-surface', className]} data-embed={embedUrl}>
  <a href={watchUrl} rel="noopener" target="_blank" class="lite-embed-trigger group absolute inset-0 block" aria-label={title}>
    {
      thumbUrl ? (
        <img src={thumbUrl} alt="" loading="lazy" width="1280" height="720" class="absolute inset-0 h-full w-full object-cover" />
      ) : (
        <div class="absolute inset-0 flex items-center justify-center bg-rule" aria-hidden="true">
          <span class="font-semibold text-ink-muted">Vimeo</span>
        </div>
      )
    }
    <span class="absolute inset-0 z-10 flex items-center justify-center" aria-hidden="true">
      <span class="flex h-14 w-14 items-center justify-center rounded-full bg-brand text-white transition-transform group-hover:scale-105">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M6 4l10 6-10 6V4z"></path>
        </svg>
      </span>
    </span>
  </a>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.lite-embed[data-embed]').forEach((el) => {
    if (el.dataset.embedInit) return;
    el.dataset.embedInit = '1';
    const trigger = el.querySelector<HTMLAnchorElement>('.lite-embed-trigger');
    trigger?.addEventListener('click', (e) => {
      e.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = el.dataset.embed!;
      iframe.title = trigger.getAttribute('aria-label') ?? '';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.className = 'absolute inset-0 h-full w-full';
      el.replaceChildren(iframe);
    });
  });
</script>
