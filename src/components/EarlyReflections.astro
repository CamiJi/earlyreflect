---
/**
 * Élément signature — motif « early reflections » (spec §6.4)
 * Une impulsion (son direct) suivie de réflexions qui s'espacent et s'atténuent :
 * hauteur décroissante (amplitude), trait plus fin, opacité moindre, espacements croissants.
 *
 * - `variant="mark"`  : petite marque à côté du nom dans le header
 * - `variant="hero"`  : motif large du hero, animation unique au chargement (< 1,2 s)
 * - `variant="bars"`  : pour l'indicateur de progression des lecteurs audio (JS pilote)
 */
interface Props {
  variant?: 'mark' | 'hero' | 'bars';
  class?: string;
  label?: string;
}

const { variant = 'mark', class: className = '', label } = Astro.props;

// Décroissance exponentielle ~0.72 : amplitude, épaisseur, opacité
// Espacements croissants : 6, 9, 12, 15, 18
const bars = [
  { x: 0, w: 8, h: 32, o: 1 }, // son direct — pleine amplitude
  { x: 14, w: 6, h: 23, o: 0.68 },
  { x: 29, w: 5, h: 16.5, o: 0.5 },
  { x: 46, w: 4, h: 11.5, o: 0.36 },
  { x: 65, w: 3.25, h: 8, o: 0.24 },
  { x: 86, w: 2.75, h: 5.5, o: 0.15 },
  { x: 108.75, w: 2.25, h: 3.5, o: 0.08 },
];

const isHero = variant === 'hero';
const isBars = variant === 'bars';
// viewBox 112×32 ; rendus : mark ≈ 64×18, hero ≈ 168×48, bars ≈ 112×24
const width = isHero ? 168 : isBars ? 112 : 64;
const height = isHero ? 48 : isBars ? 24 : 18;
---

<svg
  class={`early-reflections ${className}`}
  width={width}
  height={height}
  viewBox="0 0 112 32"
  fill="none"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  {...(label ? { 'aria-label': label } : {})}
>
  {bars.map((bar, i) => (
    <rect
      class:list={[
        'er-bar',
        { 'er-direct': i === 0, 'er-animated': isHero },
      ]}
      x={bar.x}
      y={(32 - bar.h) / 2}
      width={bar.w}
      height={bar.h}
      rx={bar.w / 2}
      fill="currentColor"
      opacity={bar.o}
      style={isHero ? `animation-delay:${i * 0.13}s` : undefined}
    />
  ))}
</svg>

<style>
  .er-bar {
    transform-origin: center;
  }
  /* §6.4 : les réflexions apparaissent dans l'ordre, < 1,2 s, une seule fois */
  .er-animated {
    animation: er-appear 0.5s cubic-bezier(0.2, 0.6, 0.3, 1) both;
  }
  .er-direct.er-animated {
    animation-duration: 0.2s;
  }
  @keyframes er-appear {
    from {
      transform: scaleY(0);
      opacity: 0.05;
    }
    to {
      transform: scaleY(1);
    }
  }
  /* prefers-reduced-motion : motif statique (géré aussi par le reset global) */
  @media (prefers-reduced-motion: reduce) {
    .er-animated {
      animation: none;
    }
  }
</style>
