---
/**
 * Image du site (assets locaux WebP, srcset responsive).
 * Fichiers générés par scripts/localize-wp-assets.mjs depuis les originaux HD
 * de l'ancien site WordPress (retour V1 §1.3/§1.4 : aucune dépendance à
 * l'ancien hébergement). key art fourni par Mathieu → remplacera ces files.
 */
import wpAssets from '../data/wp-assets.json';

interface Props {
  /** Clé dans wp-assets.json */
  asset: keyof typeof wpAssets;
  alt?: string;
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const { asset, alt, sizes = '(max-width: 768px) 100vw, 600px', class: className = '', loading = 'lazy' } = Astro.props;

const info = wpAssets[asset];
if (!info) throw new Error(`Asset inconnu: ${asset}`);

// srcset local WebP (variants triées par largeur)
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const srcset = info.localVariants.map((v) => `${base}${v.path.replace(/^\//, '')} ${v.width}w`).join(', ');
const src = `${base}${info.localSrc.replace(/^\//, '')}`;
---

<img src={src} srcset={srcset} sizes={sizes} alt={alt ?? info.alt.en} width={info.width} height={info.height} loading={loading} class={className} />
