---
/**
 * Carte projet — spec §5.2 : key art 16:9, titre, studio, années, pastilles.
 * Pas d'ombre, pas de carte « boîte » : l'image et le texte suffisent.
 */
import { pageUrl, useTranslations, type Lang } from '../i18n/ui';
import EarlyReflections from './EarlyReflections.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Lang;
}

const { project, lang } = Astro.props;
const { t, tGroup } = useTranslations(lang);
const { title, keyArt, keyArtAlt, studio, years, disciplines, nda } = project.data;
const href = pageUrl(lang, `/work/${project.id}/`);
---

<a href={href} class="group block" data-project-card data-disciplines={disciplines.join(' ')}>
  <div class="media-16x9 bg-rule">
    {
      keyArt ? (
        <img
          src={keyArt}
          alt={keyArtAlt ?? ''}
          width="1600"
          height="900"
          loading="lazy"
          class="transition-opacity group-hover:opacity-90"
        />
      ) : (
        <div class="flex h-full items-center justify-center" aria-hidden="true">
          <EarlyReflections variant="hero" class="text-ink-muted/25 transition-transform duration-300 group-hover:scale-105" />
        </div>
      )
    }
    {
      nda.active && (
        <span class="absolute top-2 right-2 rounded bg-ink/80 px-2 py-0.5 text-sm text-white">
          {t('work.underNda')}
        </span>
      )
    }
  </div>
  <div class="mt-3">
    <h3 class="font-semibold group-hover:text-brand">{title}</h3>
    <p class="tabular text-meta text-base">
      {studio} · {years}
    </p>
    <ul class="mt-2 flex flex-wrap gap-1.5">
      {disciplines.map((d) => (
        <li class="pill text-sm">{tGroup('disciplines')[d][lang]}</li>
      ))}
    </ul>
  </div>
</a>
