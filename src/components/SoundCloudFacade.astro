---
/**
 * Façade SoundCloud — spec §7 : façade ou lecteur chargé au clic.
 * Artwork via l'oEmbed SoundCloud au build, avec repli visuel « early reflections ».
 */
import EarlyReflections from './EarlyReflections.astro';

interface Props {
  /** URL complète du track ou de la playlist SoundCloud */
  url: string;
  title: string;
  class?: string;
}

const { url, title, class: className = '' } = Astro.props;
const embedBase = 'https://w.soundcloud.com/player/?url=';
const embedUrl = `${embedBase}${encodeURIComponent(url)}&color=%232e46c8&auto_play=true`;

let artwork: string | null = null;
try {
  const res = await fetch(`https://soundcloud.com/oembed?format=json&url=${encodeURIComponent(url)}`);
  if (res.ok) {
    const json = await res.json();
    artwork = json.thumbnail_url?.replace('-large', '-t500x500') ?? null;
  }
} catch {
  artwork = null;
}
---

<div class:list={['lite-embed media-16x9 relative bg-surface', className]} data-embed={embedUrl} data-embed-height="166">
  <a href={url} rel="noopener" target="_blank" class="lite-embed-trigger group absolute inset-0 block" aria-label={title}>
    {
      artwork ? (
        <img src={artwork} alt="" loading="lazy" width="500" height="500" class="absolute inset-0 h-full w-full object-cover" />
      ) : (
        <div class="absolute inset-0 flex items-center justify-center bg-rule" aria-hidden="true">
          <EarlyReflections variant="hero" class="text-ink-muted/40" />
        </div>
      )
    }
    <span class="absolute inset-0 z-10 flex items-center justify-center" aria-hidden="true">
      <span class="flex h-14 w-14 items-center justify-center rounded-full bg-brand text-white transition-transform group-hover:scale-105">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M6 4l10 6-10 6V4z"></path>
        </svg>
      </span>
    </span>
  </a>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.lite-embed[data-embed]').forEach((el) => {
    if (el.dataset.embedInit) return;
    el.dataset.embedInit = '1';
    const trigger = el.querySelector<HTMLAnchorElement>('.lite-embed-trigger');
    trigger?.addEventListener('click', (e) => {
      e.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = el.dataset.embed!;
      iframe.title = trigger.getAttribute('aria-label') ?? '';
      iframe.height = el.dataset.embedHeight ?? '166';
      iframe.scrolling = 'no';
      iframe.allow = 'autoplay';
      iframe.className = 'absolute inset-x-0 top-1/2 -translate-y-1/2 w-full';
      el.replaceChildren(iframe);
    });
  });
</script>
