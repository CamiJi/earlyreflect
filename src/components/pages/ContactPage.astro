---
/** Contact — spec §5.7 : formulaire (nom, email, type de demande, message), anti-spam Formspree, liens sociaux */
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations, type Lang } from '../../i18n/ui';
import { pages } from '../../data/pages';
import { site } from '../../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t, tGroup } = useTranslations(lang);
const altPath = '/contact/';
const formspreeUrl = `https://formspree.io/f/${site.formspreeId}`;
---

<Layout title={`${t('contact.title')} — ${t('home.heroTitle')}`} description={t('contact.intro')} lang={lang} altPath={altPath} skipLabel={t('skipToContent')}>
  <Header lang={lang} altPath={altPath} />
  <main id="main">
    <section class="container-site section !pt-16">
      <h1 class="text-2xl font-bold">{t('contact.title')}</h1>
      <p class="measure mt-3">{t('contact.intro')}</p>

      <form
        class="mt-10 max-w-xl space-y-6"
        method="POST"
        action={formspreeUrl}
        data-formspree
      >
        <div>
          <label for="name" class="block font-medium">{t('contact.name')}</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            autocomplete="name"
            class="mt-2 w-full rounded-(--radius-media) border border-rule bg-surface px-4 py-3 focus:border-brand"
          />
        </div>
        <div>
          <label for="email" class="block font-medium">{t('contact.email')}</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="mt-2 w-full rounded-(--radius-media) border border-rule bg-surface px-4 py-3 focus:border-brand"
          />
        </div>
        <div>
          <label for="request-type" class="block font-medium">{t('contact.requestType')}</label>
          <select
            id="request-type"
            name="request-type"
            class="mt-2 w-full rounded-(--radius-media) border border-rule bg-surface px-4 py-3 focus:border-brand"
          >
            {pages.contactTypes.map((type) => (
              <option value={type}>{tGroup('contact.requestTypes')[type][lang]}</option>
            ))}
          </select>
        </div>
        <div>
          <label for="message" class="block font-medium">{t('contact.message')}</label>
          <textarea
            id="message"
            name="message"
            required
            rows="6"
            class="mt-2 w-full rounded-(--radius-media) border border-rule bg-surface px-4 py-3 focus:border-brand"
          ></textarea>
        </div>
        <button type="submit" class="btn-primary">{t('contact.send')}</button>
      </form>

    </section>
  </main>
  <Footer lang={lang} altPath={altPath} />
</Layout>

<script>
  // Pré-sélection du type de demande depuis ?type= (boutons Consulting/Musique, spec §5.4)
  const typeParam = new URLSearchParams(window.location.search).get('type');
  if (typeParam) {
    const select = document.querySelector<HTMLSelectElement>('#request-type');
    if (select) {
      const match = [...select.options].find((o) =>
        o.value.toLowerCase() === typeParam.toLowerCase() ||
        o.textContent?.toLowerCase().startsWith(typeParam.toLowerCase()),
      );
      if (match) select.value = match.value;
    }
  }
</script>
