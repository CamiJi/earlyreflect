---
/**
 * Accueil one-page — retour V1 §2 :
 * HERO (4 boutons + ligne crédits) → BANDEAU image 16:6 → CRÉDITS → SHOWREEL
 * → INTRO (texte) → TROIS FACETTES chiffrées → TRAVAUX → COMPÉTENCES → OUTILS → CONTACT
 */
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import EarlyReflections from '../../components/EarlyReflections.astro';
import LiteYouTube from '../../components/LiteYouTube.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import WpImage from '../../components/WpImage.astro';
import { site } from '../../data/site';
import { pages } from '../../data/pages';
import { pageUrl, useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t, tGroup } = useTranslations(lang);
const altPath = '/';

const projects = (await getCollection('projects'))
  .filter((p) => p.id.startsWith(`${lang}/`))
  .sort((a, b) => {
    const oa = a.data.order ?? Infinity;
    const ob = b.data.order ?? Infinity;
    if (oa !== ob) return oa - ob;
    return b.data.years.localeCompare(a.data.years);
  });
const featured = projects.filter((p) => p.data.featured).slice(0, 9);

// Ligne de crédits jeux sous l'accroche (retour V1 §5, à valider par Mathieu)
const heroCredits = ['Heavy Rain', 'Detroit: Become Human', 'Watch Dogs: Legion', 'Tell Me Why', 'Banishers'];

// Facettes chiffrées (retour V1 §5) — chiffres issus de la spec (20 ans, ISART 2017, 45 étudiants, 2 BAFTA)
const facets = {
  en: [
    { title: 'Game audio', text: 'Nearly 20 years and 8 shipped titles — from Heavy Rain to Banishers: Ghosts of New Eden. Sound design, integration and dynamic mixing.' },
    { title: 'Consulting & teaching', text: 'Wwise/WAAPI consulting and pipeline audits. 45 students a year in interactive audio at ISART Digital since 2017 — 2 of their projects BAFTA-awarded.' },
    { title: 'Music', text: 'Yakie: 1 vinyl EP, official remix releases and France Inter commissions since 2020.' },
  ],
  fr: [
    { title: 'Game audio', text: 'Près de 20 ans et 8 titres livrés — de Heavy Rain à Banishers: Ghosts of New Eden. Sound design, intégration et mix dynamique.' },
    { title: 'Consulting & formation', text: 'Consulting Wwise/WAAPI et audits de pipeline. 45 étudiants par an en audio interactif à ISART Digital depuis 2017 — 2 de leurs projets primés aux BAFTA.' },
    { title: 'Musique', text: 'Yakie : 1 EP vinyle, remixes parus officiellement et commandes France Inter depuis 2020.' },
  ],
}[lang];

const skills = {
  en: [
    ['Sound design', 'SFX, foley and ambience — asset creation, recording and synthesis.'],
    ['Integration & systems', 'Wwise/Unreal implementation, WAAPI tooling, pipelines.'],
    ['Dynamic mixing', 'In-game mixing architecture, object-based mixing, review processes.'],
    ['Direction & leadership', 'Team guidance, guidelines, production coordination.'],
  ],
  fr: [
    ['Sound design', 'SFX, foley et ambiances — création d’assets, prise de son et synthèse.'],
    ['Intégration & systèmes', 'Implémentation Wwise/Unreal, outillage WAAPI, pipelines.'],
    ['Mix dynamique', 'Architecture de mix in-game, mix orienté objet, process de review.'],
    ['Direction & encadrement', 'Encadrement d’équipe, guidelines, coordination de production.'],
  ],
}[lang];

// Données structurées schema.org — spec §8 (Person sur l'accueil)
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: 'Senior sound designer, Wwise consultant and composer',
  url: Astro.site?.href,
  sameAs: site.socials.map((s) => s.url),
  knowsAbout: skills.map(([skillTitle]) => skillTitle),
  worksFor: { '@type': 'Organization', name: "Don't Nod" },
};
---

<Layout
  title={`${t('home.heroTitle')} — ${t('home.heroTagline')}`}
  description={t('home.heroTagline')}
  lang={lang}
  altPath={altPath}
  skipLabel={t('skipToContent')}
  schema={personSchema}
>
  <Header lang={lang} altPath={altPath} />

  <main id="main">
    <!-- HERO §5.1 + retour V1 §2.2/§5 : 4 boutons (1 primary, 3 secondaires), ligne crédits jeux -->
    <section class="container-site section !pt-16 md:!pt-20" aria-labelledby="hero-title">
      <h1 id="hero-title" class="text-fluid-hero font-bold tracking-tight">{t('home.heroTitle')}</h1>
      <p class="text-md mt-3 max-w-xl text-ink-muted">{t('home.heroTagline')}</p>
      <p class="text-meta mt-2 text-base">
        {heroCredits.join(' · ')}
      </p>
      <EarlyReflections
        variant="hero"
        class="text-brand mt-6"
        label={lang === 'fr' ? 'Motif early reflections' : 'Early reflections motif'}
      />
      <div class="mt-8 grid max-w-xl grid-cols-2 gap-3 sm:flex sm:flex-wrap">
        <a href="#showreel" class="btn-primary">{t('home.seeShowreel')}</a>
        <a href={pageUrl(lang, '/contact/')} class="btn-secondary">{t('home.contactMe')}</a>
        <a href={site.cvPdf[lang]} target="_blank" rel="noopener" class="btn-secondary">
          {lang === 'fr' ? 'Télécharger le CV (PDF)' : 'Download CV (PDF)'}
        </a>
        <a href="https://www.linkedin.com/in/mathieu-fiorentini-8b18b045" target="_blank" rel="me noopener" class="btn-secondary">LinkedIn</a>
      </div>
    </section>

    <!-- BANDEAU image 16:6 pleine largeur — retour V1 §2.3 (recadrage HD à fournir par Mathieu) -->
    <section class="container-site" aria-label={lang === 'fr' ? 'Bandeau : en studio' : 'Banner: in the studio'}>
      <div class="w-full overflow-hidden rounded-(--radius-media)" style="aspect-ratio: 16/6;">
        <WpImage asset="photoStudio" sizes="(max-width: 1200px) 100vw, 1200px" class="h-full w-full object-cover" loading="eager" />
      </div>
    </section>

    <!-- CRÉDITS — remontés sous le bandeau, retour V1 §2.1/§2.4 -->
    <section class="container-site section" aria-labelledby="credits-title">
      <h2 id="credits-title" class="text-lg font-bold">{t('home.creditsTitle')}</h2>
      <ul class="mt-6 flex flex-wrap items-center gap-x-10 gap-y-6 md:flex-nowrap md:justify-between">
        {(['logoQuanticDream', 'logoUbisoft', 'logoIsart', 'logoIna', 'logoGaumont'] as const).map((key) => (
          <li class="flex h-8 items-center">
            <WpImage
              asset={key}
              sizes="160px"
              class="h-8 w-auto max-w-[150px] object-contain object-left opacity-55 grayscale transition-all hover:opacity-100 hover:grayscale-0"
            />
          </li>
        ))}
        {["Don't Nod", 'Focus Entertainment', 'France Inter'].map((name) => (
          <li class="text-meta font-semibold transition-colors hover:text-ink" data-credit={name}>
            {name}
          </li>
        ))}
      </ul>
      <p class="text-meta mt-3 text-sm">
        {lang === 'fr'
          ? 'Logos Don’t Nod, Focus et France Inter à fournir (SVG monochromes) pour l’homogénéité — retour V1 §2.4.'
          : 'Don’t Nod, Focus and France Inter logos to be provided (monochrome SVGs) for consistency — retour V1 §2.4.'}
      </p>
    </section>

    <!-- SHOWREEL §5.1 : vidéo 16:9 large, façade cliquable, légende courte -->
    <section id="showreel" class="container-site section" aria-label="Showreel">
      <LiteYouTube id={site.showreelYouTubeId} title="Showreel 2014–2025" />
      <p class="text-meta mt-2">{t('home.showreelCaption')}</p>
    </section>

    <!-- INTRO §5.1 : texte seul (l'image est passée en bandeau, retour V1 §2.3) -->
    <section class="container-site section" aria-labelledby="intro-title">
      <h2 id="intro-title" class="text-lg font-bold">{t('home.introTitle')}</h2>
      <p class="measure mt-3">{pages.about.bioShort[lang]}</p>
    </section>

    <!-- TROIS FACETTES §5.1 : chiffrées (retour V1 §5), porte le profil hybride -->
    <section class="container-site section" aria-labelledby="facets-title">
      <h2 id="facets-title" class="text-lg font-bold">{t('home.facetsTitle')}</h2>
      <div class="mt-8 grid gap-8 md:grid-cols-3">
        {
          facets.map((facet, i) => (
            <div>
              <h3 class="font-semibold text-brand">{facet.title}</h3>
              <p class="mt-2">{facet.text}</p>
              <a href={[pageUrl(lang, '/work/'), pageUrl(lang, '/consulting/'), pageUrl(lang, '/music/')][i]} class="mt-3 inline-block font-medium hover:text-brand" aria-label={facet.title}>
                {lang === 'fr' ? 'En savoir plus' : 'Learn more'}
              </a>
            </div>
          ))
        }
      </div>
    </section>

    <!-- TRAVAUX SÉLECTIONNÉS §5.1 : 6 à 9 projets mis en avant -->
    <section class="container-site section" aria-labelledby="work-title">
      <div class="flex items-baseline justify-between gap-4">
        <h2 id="work-title" class="text-lg font-bold">{t('home.selectedWork')}</h2>
        <a href={pageUrl(lang, '/work/')} class="text-brand hover:underline">{t('home.allWork')}</a>
      </div>
      <div class="mt-8">
        <ProjectGrid projects={featured} lang={lang} withFilters={false} />
      </div>
    </section>

    <!-- COMPÉTENCES §5.1 : 4 blocs courts -->
    <section class="container-site section" aria-labelledby="skills-title">
      <h2 id="skills-title" class="text-lg font-bold">{t('home.skillsTitle')}</h2>
      <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          skills.map(([skillTitle, text]) => (
            <div>
              <h3 class="font-semibold">{skillTitle}</h3>
              <p class="text-meta mt-2">{text}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- OUTILS §5.1 : logos monochromes (texte en attendant les SVG, §9.6) -->
    <section class="container-site section" aria-labelledby="tools-title">
      <h2 id="tools-title" class="text-lg font-bold">{t('home.toolsTitle')}</h2>
      <ul class="mt-6 flex flex-wrap gap-x-10 gap-y-4">
        {
          site.tools.map((name) => (
            <li class="text-meta font-semibold transition-colors hover:text-ink" data-tool={name}>
              {name}
            </li>
          ))
        }
      </ul>
    </section>

    <!-- CONTACT §5.1 + retour V1 §2.5 : bouton seulement, pas d'email en clair -->
    <section class="container-site section" aria-labelledby="contact-title">
      <h2 id="contact-title" class="text-lg font-bold">{t('home.contactTitle')}</h2>
      <p class="measure mt-3">{t('home.contactText')}</p>
      <a href={pageUrl(lang, '/contact/')} class="btn-primary mt-6 inline-flex">{t('home.contactMe')}</a>
    </section>
  </main>

  <Footer lang={lang} altPath={altPath} />
</Layout>
