---
/** Consulting & formation — spec §5.4 */
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations, pageUrl, type Lang } from '../../i18n/ui';
import { pages } from '../../data/pages';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t, tGroup } = useTranslations(lang);
const p = pages.consulting;
const altPath = '/consulting/';
const requestType = lang === 'fr' ? 'Consulting' : 'Consulting';
---

<Layout title={`${p.title[lang]} — ${t('home.heroTitle')}`} description={p.intro[lang]} lang={lang} altPath={altPath} skipLabel={t('skipToContent')}>
  <Header lang={lang} altPath={altPath} />
  <main id="main">
    <section class="container-site section !pt-16">
      <h1 class="text-2xl font-bold">{p.title[lang]}</h1>
      <p class="measure mt-3">{p.intro[lang]}</p>
    </section>

    <!-- Offres : 3 blocs [À VALIDER : périmètre exact] -->
    <section class="container-site section" aria-labelledby="offers-title">
      <h2 id="offers-title" class="text-lg font-bold">{lang === 'fr' ? 'Offres' : 'Services'}</h2>
      <div class="mt-8 grid gap-8 md:grid-cols-3">
        {p.offers.map((offer) => (
          <div class="rounded-(--radius-media) border border-rule bg-surface p-6">
            <h3 class="font-semibold">{offer.title[lang]}</h3>
            <p class="text-meta mt-2">{offer.text[lang]}</p>
          </div>
        ))}
      </div>
      <a
        href={`${pageUrl(lang, '/contact/')}?type=${requestType}`}
        class="btn-primary mt-10 inline-flex"
      >
        {lang === 'fr' ? 'Demander un devis' : 'Request a quote'}
      </a>
    </section>

    <!-- Enseignement -->
    <section class="container-site section" aria-labelledby="teaching-title">
      <h2 id="teaching-title" class="text-lg font-bold">{p.teaching.title[lang]}</h2>
      <p class="measure mt-3">{p.teaching.text[lang]}</p>
    </section>

    <!-- Publications -->
    <section class="container-site section" aria-labelledby="publications-title">
      <h2 id="publications-title" class="text-lg font-bold">{p.publications.title[lang]}</h2>
      <ul class="measure mt-4 space-y-2">
        {p.publications.items.map((item) => (
          <li>
            <a href={item.url} rel="noopener" target="_blank" class="text-brand hover:underline">{item.label}</a>
          </li>
        ))}
      </ul>
    </section>
  </main>
  <Footer lang={lang} altPath={altPath} />
</Layout>
