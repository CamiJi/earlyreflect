---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EarlyReflections from '../components/EarlyReflections.astro';
---

<Layout title="Page not found — Mathieu Fiorentini" description="Page not found." lang="en" skipLabel="Skip to main content">
  <Header lang="en" altPath="/" />
  <main id="main" class="container-site section !pt-24">
    <EarlyReflections variant="hero" class="text-rule" />
    <h1 class="text-2xl font-bold mt-8">Page not found</h1>
    <p class="mt-3">This page doesn't exist. <a href="/" class="text-signal hover:underline">Back to home</a></p>
  </main>
  <Footer lang="en" altPath="/" />
</Layout>
